{
  "name": "@lantrinh1999/pi-cache-insights",
  "version": "1.0.0",
  "description": "Prefix-cache telemetry for pi: hit rate, reused tokens, real cost saved, per-turn trend with cache-break detection, and optional OpenRouter upstream pinning",
  "keywords": [
    "pi-package",
    "pi-extension",
    "cache",
    "prefix-cache",
    "prompt-cache",
    "deepseek",
    "openrouter",
    "telemetry"
  ],
  "license": "MIT",
  "author": "Robin Quintero (original pi-deepseek-cache), fork maintained by lantrinh1999",
  "contributors": [
    "Robin Quintero",
    "lantrinh1999"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lantrinh1999/pi-deepseek-cache.git"
  },
  "bugs": {
    "url": "https://github.com/lantrinh1999/pi-deepseek-cache/issues"
  },
  "files": [
    "extensions/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run test",
    "smoke": "node --experimental-strip-types ./scripts/smoke.ts"
  },
  "type": "module"
}
